# 이 파일을 저장소 루트의 .env로 복사한 뒤 실제 값을 입력하세요.
# .env는 .gitignore/.dockerignore에 포함되어 Git과 Docker 이미지에 들어가지 않습니다.

# Docker Hub 이미지 좌표. 팀원은 기본값 그대로 사용하면 됩니다.
DOCKERHUB_USERNAME=yusae
CARDOC_IMAGE_TAG=1.0

# OpenAI 사진 복원 — 실제 키는 이 한 곳 또는 배포 서비스의 Secret 환경변수에만 입력
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_TIMEOUT=180

# 선택: 공개 배포 시 임의 호출을 막는 frontend↔backend 공유 토큰(긴 임의 문자열)
REPAIR_API_TOKEN=
REPAIR_RATE_LIMIT_PER_MINUTE=4
REPAIR_MAX_CONCURRENT_GENERATIONS=1

# 로컬 backend의 카카오 라우터를 직접 시험할 때만 필요합니다.
# 기본 지도/견적 요청은 팀장님 main 정책에 따라 Render로 전송됩니다.
KAKAO_REST_API_KEY=

# 상담 LLM은 기존 Ollama를 사용합니다.
OLLAMA_MODEL=exaone3.5:2.4b
OLLAMA_TIMEOUT=300
OLLAMA_RETRY_TIMEOUT=45
OLLAMA_MAX_TOKENS=160
OLLAMA_NUM_CTX=3072
RAG_TOP_K=3
RAG_MAX_CONTEXT_CHARS=1800

# Codespaces CPU에서 backend 생성과 짧은 한국어 재시도를 기다리는 frontend 제한
CHAT_API_TIMEOUT=360

# 진단·상담·OpenAI 복원 요청을 처리할 로컬 통합 FastAPI 주소
BACKEND_BASE_URL=http://127.0.0.1:8000

# 선택: 지도·견적 요청을 로컬 backend로 바꿀 때만 지정합니다.
MAP_BACKEND_BASE_URL=

# 기본 지도·견적 경량 서버(Render). MAP_BACKEND_BASE_URL이 없으면 사용됩니다.
ESTIMATE_API_BASE_URL=https://team-12-project.onrender.com
