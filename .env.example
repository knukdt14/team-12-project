# 복사해서 .env로 만들고 실제 값 채워넣기 (.env는 .gitignore에 포함되어 git에 올라가지 않음)
# Kakao Developers(https://developers.kakao.com)에서 개인 계정으로 무료 발급
KAKAO_REST_API_KEY=

# HuggingFace 액세스 토큰 — AI 복원 이미지 생성(repair_inpaint.py, FLUX.1-Kontext-dev) 사용 시에만 필요.
# https://huggingface.co/settings/tokens 에서 발급(Read 권한이면 충분), 로그인은 `hf auth login`으로도 가능(그 경우 이 값 생략 가능).
# 이 모델은 gated repo라 https://huggingface.co/black-forest-labs/FLUX.1-Kontext-dev 에서 라이선스 동의도 별도로 필요함.
HF_TOKEN=

# app.py가 호출할 estimate_api.py(카카오맵/견적) 서버 주소.
# 비밀값 아님 — Render에 배포된 공용 서버 주소라 기본값 그대로 써도 됨.
# 로컬 estimate_api.py를 직접 띄워 테스트할 땐 http://127.0.0.1:8000 으로 바꿀 것.
ESTIMATE_API_BASE_URL=https://team-12-project.onrender.com
