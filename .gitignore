# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
env/
.env

# Dataset (2GB+, re-downloadable from Roboflow — see README)
# 주의: 앞에 "/"를 붙여 저장소 루트의 data/만 무시하도록 한정함.
# "/" 없이 "data/"라고만 쓰면 backend/data/ 같은 하위 data 폴더까지 전부 무시돼서
# backend/data/단가표.json이 한 번도 git에 커밋되지 못하는 버그가 있었음.
/data/

# backend/data/는 위 규칙(data/)에 걸리지만, 단가표.json은 코드가 참조하는
# 작은 설정성 데이터라 예외로 git에 포함
!backend/data/
backend/data/*
!backend/data/단가표.json

# Pretrained base weights (auto-downloaded by ultralytics on first run)
yolo11n.pt
yolo26n.pt

# Training runs — keep only the deployed model weights
runs/*

!runs/damage_type_classifier/
runs/damage_type_classifier/*
!runs/damage_type_classifier/best.pt

# 현재 배포 모델 (YOLO11n, 16종 Bodypanel-Dent 제거 재학습, test mAP50 0.887)
!runs/detect/
runs/detect/*
!runs/detect/runs/
runs/detect/runs/*
!runs/detect/runs/train_20260804_1124/
runs/detect/runs/train_20260804_1124/*
!runs/detect/runs/train_20260804_1124/weights/
runs/detect/runs/train_20260804_1124/weights/*
!runs/detect/runs/train_20260804_1124/weights/best.pt

# Misc
results/*
!results/.gitkeep
*.log
.DS_Store
Thumbs.db

# 앱 실행 중 자동 생성되는 로컬 진단 기록 (사람마다 값이 달라 커밋 대상 아님)
diagnosis_log.csv

# 사용된 데이터 zip파일
data.zip

# CarDD 손상 종류 분류용 데이터 (대용량, 별도 다운로드/빌드로 재현 가능)
cardd_raw/
damage_type_crops/

# 클로드 규칙 관련
Claude.md