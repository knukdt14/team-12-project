# backend/.env.example
# 실제 값은 .env 파일에 넣고 커밋하지 마세요 (.gitignore에 .env 이미 포함됨).
# main.py의 load_dotenv()는 backend/ 안에서 실행해도 상위 폴더까지 올라가며 .env를 찾으므로,
# 저장소 루트에 .env를 둬도 되고 backend/ 안에 둬도 됩니다.

# 카카오 로컬 API 키 (정비소 검색, routers/repair_shops.py)
KAKAO_REST_API_KEY=

# Ollama 관련 (services/llm_client.py) — 필요 시 오버라이드
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=exaone3.5:2.4b
# OLLAMA_TIMEOUT=300
# OLLAMA_RETRY_TIMEOUT=45
# OLLAMA_MAX_TOKENS=160
# OLLAMA_NUM_CTX=3072

# RAG 검색량 — Codespaces CPU 환경에서는 문맥을 작게 유지하는 편이 안정적입니다.
# RAG_TOP_K=3
# RAG_MAX_CONTEXT_CHARS=1800
